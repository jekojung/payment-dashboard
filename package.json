{
  "name": "tpg-center-platform",
  "version": "0.1.0",
  "private": true,
  "description": "ระบบติดตามงานคลังสินค้าและขนส่ง บริษัท TPG Center — Core Platform (เฟส 0) + โมดูล 1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "prisma:generate": "pnpm --filter @tpg/api prisma:generate",
    "prisma:migrate": "pnpm --filter @tpg/api prisma:migrate",
    "prisma:seed": "pnpm --filter @tpg/api prisma:seed",
    "db:reset": "pnpm --filter @tpg/api db:reset"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
