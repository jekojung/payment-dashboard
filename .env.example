# ============================================================
# TPG Center Platform — environment variables (example)
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง:  cp .env.example .env
# ============================================================

# ---------- General ----------
NODE_ENV=development
TZ=Asia/Bangkok

# ---------- API (apps/api) ----------
API_PORT=3000
API_BASE_URL=http://localhost:3000
# CORS: origin ของเว็บ (apps/web)
WEB_ORIGIN=http://localhost:5173

# ---------- Database (PostgreSQL + Prisma) ----------
# รูปแบบ: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tpg_center?schema=public

# ---------- Auth (JWT) ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- LINE Messaging API ----------
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
# Webhook ที่ตั้งใน LINE Developers Console: {API_BASE_URL}/line/webhook

# ---------- LIFF (ฟอร์มใน LINE) ----------
# LIFF app ผูกกับ endpoint ของ apps/web (เช่น {WEB_ORIGIN}/liff/...)
LIFF_ID=your-liff-id

# ---------- Google Drive Storage (Service Account) ----------
# วางทั้ง JSON ของ service account (escaped) หรือชี้ path ไปยังไฟล์ก็ได้
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./google-service-account.json
# โฟลเดอร์ปลายทางบน Google Drive ที่แชร์ให้ service account แล้ว
GDRIVE_FOLDER_ID=your-google-drive-folder-id

# ---------- Web (apps/web) — ตัวแปรขึ้นต้นด้วย VITE_ ----------
VITE_API_BASE_URL=http://localhost:3000
VITE_LIFF_ID=your-liff-id
