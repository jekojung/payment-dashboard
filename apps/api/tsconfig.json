{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@tpg/shared": ["../../packages/shared/src/index.ts"],
      "@tpg/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*"]
}
